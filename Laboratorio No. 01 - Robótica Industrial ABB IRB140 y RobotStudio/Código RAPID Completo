    !!! HOME
PROC Homming()
        VAR robtarget pActual;  
         
        pActual := CRobT(\Tool:=Marcador \WObj:=wobj0); ! 1. Leemos la posición actual #Current Robot Target
        
        IF pActual.trans.z < 400 THEN ! 2. Evaluamos si el robot está en la zona de riesgo (cerca de la mesa)
                                      ! Si ya está arriba no subimos primero en z
            ConfJ \Off;    !El robot escoje la configuración de ejes más cercana y accesible para llegar al punto          
            MoveJ Offs(pActual, 0, 0, 200), v500, fine, Marcador\WObj:=wobj0; !Sube 200 mm (desplazamiento vectorial)
            ConfJ \On;
        ENDIF
        
        !Viaje final a posición Home
        MoveAbsJ home, v500, fine, Marcador;
    ENDPROC
    
    
  !!! BANDA TRANSPORTADORA
    PROC CForward() !ABEL
        Reset BWD_Conveyor; !Primero aseguro el apagado del sentido contrario
        WaitTime 0.3;
        Set FWD_Conveyor; !Va hacia adelante
    ENDPROC
    
    PROC CBackward()
        Reset FWD_Conveyor; !Primero apago el forward
        Set BWD_Conveyor; !va hacia atras
        WaitTime 2.5;  !Es el tiempo de avance en la rutina de hacer el decorado, manteniendo la caja en la posición medida del workjdata
        ReSet BWD_Conveyor; !Se apaga el desplazamiento
        WaitTime 0.5;
    ENDPROC
    
    PROC Parada() !Apago direccion hacia adelante y hacia atras
        Reset FWD_Conveyor; 
        Reset BWD_Conveyor;
    ENDPROC 
    
    
    !!!!!! MANTENIMIENTO
    PROC Mantenimiento()
        ! Movimiento articular absoluto usando la herramienta
        Set DO_02; !Prende testigo
        MoveAbsJ jpos_objetivo,v500,fine,Marcador;

    ENDPROC    

    
        
    
    !!!!!! FARMEAR AURA

    PROC FarmearAura()            
        Set DO_03; !Encendemos Testigo
        Path_10_D3;
        Path_20_D3;
        Path_30_D3;
       ! Path_40_D3;  !Por limitación del espacio de trabajo en el laboratorio se optó por no utilizar esta rutina
        Homming;
        Reset DO_03; !Apagamos Testigo
    ENDPROC


    ! Ciclo Decorado
    PROC CicloDecoracion()
        set ArrancaPastel;  !Inicia la variable de entrada del smart component para la simulacion de la banda transportadora!
        CForward; !Inicia la banda transportadora real
        WaitTime 2.5; !69 cm
        reset ArrancaPastel;
        Parada;!Parala banda transportadora
        WaitTime 3; ! .
        Set DO_01; !Enciende testigo
        Path_10; !Decora
        Reset DO_01; !Apaga testigo 
        
        Homming; 
        WaitTime 1;
        set pastelTerminado; !Inicia la variable de entrada del smart component para la simulacion final de la banda transportadora!
        CForward; !Inicia la banda transportadora real
        WaitTime 5; 
        Parada;
        reset pastelTerminado;
        
    ENDPROC
    
    
